<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarmRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/alarm_bg">

    <!-- Slowly drifting aurora glows behind the content -->
    <View
        android:id="@+id/glowTop"
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-140dp"
        android:layout_marginTop="-120dp"
        android:background="@drawable/alarm_glow_seafoam" />

    <View
        android:id="@+id/glowBottom"
        android:layout_width="460dp"
        android:layout_height="460dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-180dp"
        android:layout_marginBottom="-120dp"
        android:background="@drawable/alarm_glow_petal" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="sans-serif-thin"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:textColor="#FFFFFFFF"
            android:textSize="76sp" />

        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:format12Hour="EEEE, d MMMM"
            android:format24Hour="EEEE, d MMMM"
            android:letterSpacing="0.02"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/iconWrap"
            android:layout_width="230dp"
            android:layout_height="230dp">

            <View
                android:id="@+id/ring1"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/alarm_ring" />

            <View
                android:id="@+id/ring2"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/alarm_ring" />

            <View
                android:id="@+id/ring3"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/alarm_ring" />

            <FrameLayout
                android:id="@+id/iconCircle"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="center"
                android:background="@drawable/alarm_icon_circle">

                <TextView
                    android:id="@+id/emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🔔"
                    android:textSize="54sp" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.32"
            android:text="REMINDER"
            android:textColor="#CCA8D5C8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/reminderText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:gravity="center"
            android:lineSpacingMultiplier="1.12"
            android:maxLines="5"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/burstPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/alarm_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="16dp"
            android:paddingTop="7dp"
            android:paddingEnd="16dp"
            android:paddingBottom="7dp"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnDone"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:background="@drawable/alarm_btn_primary"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:text="✓   Done"
                android:textColor="#FF1A4A40"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSnooze"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/alarm_btn_glass"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="Snooze · 5 min"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/btnDismiss"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/alarm_btn_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="Dismiss"
                    android:textColor="#D9FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:textColor="#80FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
